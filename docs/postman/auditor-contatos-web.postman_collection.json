{
  "info": {
    "_postman_id": "5df51618-7d60-4e07-a221-02db2c27e8a8",
    "name": "Auditor de Contatos Web",
    "description": "Coleção oficial para testar a API do Auditor de Contatos Web. Inclui healthcheck, documentação OpenAPI, criação de varreduras, consulta de status, listagem de contatos e cenários de erro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health e documentação",
      "item": [
        {
          "name": "Healthcheck",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"API online\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifica se a API está online."
          },
          "response": []
        },
