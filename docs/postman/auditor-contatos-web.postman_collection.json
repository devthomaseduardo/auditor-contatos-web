    {
      "name": "Demonstração local",
      "description": "Fluxo recomendado para demonstrar o projeto usando o site local em teste/.",
      "item": [
        {
          "name": "Criar varredura local",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status HTTP 202\", function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"varredura criada\", function () {",
                  "  pm.expect(json.id).to.be.a(\"number\");",
                  "  pm.expect(json.status).to.eql(\"pendente\");",
                  "});",
                  "",
                  "pm.environment.set(\"varredura_id\", json.id);",
                  "pm.environment.set(\"ultima_url_varredura\", json.url);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{local_site_url}}/index.html\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/varreduras",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "varreduras"
              ]
            },
            "description": "Cria uma varredura usando o site local servido por `python -m http.server 8765 -d teste`."
          },
          "response": []
        },
        {
          "name": "Consultar varredura local",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"status conhecido\", function () {",
                  "  pm.expect([\"pendente\", \"em_andamento\", \"concluida\", \"erro\"]).to.include(json.status);",
                  "});",
                  "",
                  "pm.test(\"URL inicial preservada\", function () {",
                  "  pm.expect(json.url).to.eql(pm.environment.get(\"ultima_url_varredura\"));",
                  "});",
                  "",
                  "if (json.status === \"concluida\") {",
                  "  pm.test(\"varredura local encontrou contatos\", function () {",
                  "    pm.expect(json.quantidade_paginas).to.be.at.least(1);",
                  "    pm.expect(json.quantidade_contatos).to.be.at.least(1);",
                  "    pm.expect(json.erro).to.eql(null);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/varreduras/{{varredura_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "varreduras",
                "{{varredura_id}}"
              ]
            },
            "description": "Consulta o status da varredura local. Repita após alguns segundos até aparecer `concluida` ou `erro`."
          },
          "response": []
        },
        {
          "name": "Listar contatos da varredura local",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"retorna lista\", function () {",
                  "  pm.expect(json).to.be.an(\"array\");",
                  "});",
                  "",
                  "if (json.length > 0) {",
                  "  pm.test(\"contato tem campos esperados\", function () {",
                  "    pm.expect(json[0]).to.have.property(\"id\");",
                  "    pm.expect(json[0]).to.have.property(\"email\");",
                  "    pm.expect(json[0]).to.have.property(\"pagina_origem\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/varreduras/{{varredura_id}}/contatos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "varreduras",
                "{{varredura_id}}",
                "contatos"
              ]
            },
            "description": "Lista os e-mails encontrados na varredura local."
          },
          "response": []
        },
        {
          "name": "Criar varredura local com erro 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status HTTP 202\", function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"varredura de erro criada\", function () {",
                  "  pm.expect(json.id).to.be.a(\"number\");",
                  "  pm.expect(json.status).to.eql(\"pendente\");",
                  "});",
                  "",
                  "pm.environment.set(\"erro_id\", json.id);",
                  "pm.environment.set(\"ultima_url_erro\", json.url);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{local_site_url}}/nao-existe.html\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/varreduras",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "varreduras"
              ]
            },
            "description": "Cria uma varredura de erro controlado usando uma página inexistente no site local."
          },
          "response": []
        },
        {
          "name": "Consultar varredura local com erro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"URL de erro preservada\", function () {",
                  "  pm.expect(json.url).to.eql(pm.environment.get(\"ultima_url_erro\"));",
                  "});",
                  "",
                  "if (json.status === \"erro\") {",
                  "  pm.test(\"erro persistido\", function () {",
                  "    pm.expect(json.quantidade_paginas).to.eql(0);",
                  "    pm.expect(json.quantidade_contatos).to.eql(0);",
                  "    pm.expect(json.erro).to.include(\"HTTP 404\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/varreduras/{{erro_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "varreduras",
                "{{erro_id}}"
              ]
            },
            "description": "Consulta a varredura de erro. Repita após alguns segundos até o status aparecer como `erro`."
          },
          "response": []
        }
      ]
    },
